{
  "name": "warlords2-clone",
  "version": "0.1.0",
  "private": true,
  "description": "Warlords II clone - turn-based strategy with four factions, stack-based combat, heroes, and AI opponents. Faithful to the 1993 SSI classic, rebuilt with Phaser 3, TypeScript, and Vite.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.{ts,css,html}\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^3.86.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
