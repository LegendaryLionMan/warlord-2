{
  "name": "warlord-2",
  "version": "1.0.0",
  "private": true,
  "description": "Warlord 2 - a turn-based strategy with eight factions, stack-based combat, heroes, and AI opponents. Inspired by the 1990s 4X wargame tradition; built from scratch with Phaser 3, TypeScript, and Vite. Not affiliated with SSG or Ubisoft.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:sprites && tsc -b && vite build",
    "build:sprites": "node scripts/build-sprites.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,css,html}\" \"tests/**/*.{ts,css,html}\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "^3.86.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "jsdom": "^25.0.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
